<?xml version="1.0" encoding="UTF-8"?>
<!-- OmniROM 7.1.2 for Samsung Galaxy J5 2016 (SM-J510FN / j5xnlte) -->
<manifest>
  <remote name="gh" fetch="https://github.com" />

  <!-- omnirom deleted android-7.1 of these two; the omnirom-legacy archive still has them -->
  <remove-project name="android_frameworks_base" />
  <remove-project name="android_system_core" />
  <project path="frameworks/base" name="omnirom-legacy/android_frameworks_base" remote="gh" revision="android-7.1" groups="pdk-cw-fs" />
  <project path="system/core"     name="omnirom-legacy/android_system_core"     remote="gh" revision="android-7.1" groups="pdk" />

  <!-- These Omni apps were deleted from GitHub. Settings compiles OmniGears in,
       so take an unmodified fork (same head as Omni's last android-7.1 commit);
       the rest are optional extras and are dropped. -->
  <remove-project name="android_packages_apps_OmniGears" />
  <project path="packages/apps/OmniGears" name="Dark-OS/android_packages_apps_OmniGears" remote="gh" revision="android-7.1" />
  <!-- omni-security mirrors Omni's last android-7.1 OmniClock (OmniClockOSS) and OmniSwitch -->
  <remove-project name="android_packages_apps_OmniClock" />
  <project path="packages/apps/OmniClock"  name="omni-security/android_packages_apps_OmniClock"  remote="gh" revision="android-7.1" />
  <remove-project name="android_packages_services_OmniJaws" />
  <remove-project name="android_packages_apps_OmniSubs" />
  <remove-project name="android_packages_apps_OmniStyle" />
  <remove-project name="android_packages_apps_OmniSwitch" />
  <project path="packages/apps/OmniSwitch" name="omni-security/android_packages_apps_OmniSwitch" remote="gh" revision="android-7.1" />
  <remove-project name="android_packages_apps_OpenDelta" />

  <!-- Omni's stock HALs have no msm8916 support: swap in LineageOS CAF msm8916 HALs at the same paths -->
  <remove-project name="android_hardware_qcom_display" />
  <remove-project name="android_hardware_qcom_audio" />
  <remove-project name="android_hardware_qcom_media" />
  <remove-project name="android_hardware_ril" />
  <project path="hardware/qcom/display" name="LineageOS/android_hardware_qcom_display" remote="gh" revision="cm-14.1-caf-8916" />
  <project path="hardware/qcom/audio"   name="LineageOS/android_hardware_qcom_audio"   remote="gh" revision="cm-14.1-caf-8916" />
  <project path="hardware/qcom/media"   name="LineageOS/android_hardware_qcom_media"   remote="gh" revision="cm-14.1-caf-8916" />
  <project path="hardware/ril"          name="LineageOS/android_hardware_ril"          remote="gh" revision="cm-14.1-caf" />

  <!-- Device trees (j5xnlte itself comes from this repo, copied in by the workflow) -->
  <project path="device/samsung/j5-common"      name="Galaxy-MSM8916/android_device_samsung_j5-common"      remote="gh" revision="cm-14.1" />
  <project path="device/samsung/msm8916-common" name="Galaxy-MSM8916/android_device_samsung_msm8916-common" remote="gh" revision="cm-14.1" />
  <project path="device/samsung/qcom-common"    name="LineageOS/android_device_samsung_qcom-common"         remote="gh" revision="cm-14.1" />
  <project path="device/qcom/common"            name="LineageOS/android_device_qcom_common"                 remote="gh" revision="cm-14.1" />
  <project path="device/qcom/sepolicy"          name="LineageOS/android_device_qcom_sepolicy"               remote="gh" revision="cm-14.1" />

  <!-- Kernel (requested: Dyeide) -->
  <project path="kernel/samsung/msm8916" name="Dyeide/android_kernel_samsung_msm8916" remote="gh" revision="cm-14.1" />

  <!-- Proprietary blobs -->
  <project path="vendor/samsung" name="Galaxy-MSM8916/proprietary_vendor_samsung" remote="gh" revision="cm-14.1" />

  <!-- The cm-14.1 vendor branch has no J5 2016 set (it ships the J500's T13QL camera
       module etc.); lineage-15.1 has j5x-common + j5xnlte from J510 firmware -->
  <project path="vendor/samsung-j5x" name="Galaxy-MSM8916/proprietary_vendor_samsung" remote="gh" revision="lineage-15.1" clone-depth="1" />

  <!-- Dependencies -->
  <project path="vendor/qcom/opensource/dataservices" name="LineageOS/android_vendor_qcom_opensource_dataservices" remote="gh" revision="cm-14.1" />
  <project path="hardware/samsung"                  name="LineageOS/android_hardware_samsung"                  remote="gh" revision="cm-14.1" />
  <project path="packages/resources/devicesettings" name="LineageOS/android_packages_resources_devicesettings" remote="gh" revision="cm-14.1" />
  <project path="external/sony/boringssl-compat"    name="LineageOS/android_external_sony_boringssl-compat"    remote="gh" revision="cm-14.1" />
  <project path="external/stlport"                  name="LineageOS/android_external_stlport"                  remote="gh" revision="cm-14.1" />
</manifest>
